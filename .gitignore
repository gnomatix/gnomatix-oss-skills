# OS / editor
.DS_Store
Thumbs.db
.vscode/
.idea/
*.swp
*.swo

# Node (in case anyone adds tooling later)
node_modules/
package-lock.json
yarn.lock
pnpm-lock.yaml

# Python (this is a python-elimination repo; if any of these appear, something has gone very wrong)
__pycache__/
*.pyc
*.pyo
.venv/
venv/
.python-version

# Logs / scratch / backups
*.log
scratch/
tmp/
.bak/

# Per-machine Claude Code overrides (not for public repo)
.claude/settings.local.json

# Beads / Dolt files (added by bd init)
.dolt/
*.db
.beads-credential-key
.beads.gate.lock
.beads/proxieddb/

# local hook logs
**/.claude/logs/

# dotenvx private keys (never commit)
.env.keys
**/.env.keys

# per-project plugin settings
.claude/*.local.md
.claude/*.local.json
