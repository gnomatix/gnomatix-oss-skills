{
  "description": "did-you-rtfm hooks — Stop / SubagentStop pivot-language detector + PreToolUse Bash bypass-flag denier. Harness-level enforcement of the did-you-rtfm skill.",
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node ${CLAUDE_PLUGIN_ROOT}/hooks/did-you-rtfm-stop.js",
            "timeout": 10
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node ${CLAUDE_PLUGIN_ROOT}/hooks/did-you-rtfm-stop.js",
            "timeout": 10
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "node ${CLAUDE_PLUGIN_ROOT}/hooks/did-you-rtfm-bypass.js",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
