{
  "description": "satori (悟り): per-turn reminder. One UserPromptSubmit hook injecting the characters, untranslated.",
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node ${CLAUDE_PLUGIN_ROOT}/hooks/satori-reminder.js",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
