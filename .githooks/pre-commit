#!/bin/sh
# Verify marketplace standalone/dovetailing integrity and block context pollution,
# then bump the version of each plugin whose content changed (main only).
# Enable once per clone: git config core.hooksPath .githooks
set -e
if [ -f scripts/audit-marketplace-integrity.js ] && [ -f .claude-plugin/marketplace.json ]; then
  node scripts/audit-marketplace-integrity.js
fi
exec node scripts/version-bump.js
